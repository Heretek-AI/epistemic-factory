{
	"name": "@heretek-ai/es-cli",
	"version": "3.0.0",
	"description": "Gated Build Factory CLI (`es`): human key sealing, project scaffolding, status, signed stage approvals, research audit, mutation gate, and `.worktreeinclude` secret sync.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Heretek-AI/epistemic-factory.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/Heretek-AI/epistemic-factory#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE*"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"es": "./dist/bin.js"
	},
	"dependencies": {
		"@heretek-ai/epistemic-verifier-mcp": "^3.0.0",
		"@heretek-ai/es-core": "^3.0.0"
	},
	"scripts": {
		"test": "bun test",
		"check": "tsc --noEmit",
		"build": "tsc -b tsconfig.build.json && node ../../scripts/fix-dist-bins.mjs dist/bin.js",
		"prepublishOnly": "npm run build"
	}
}
